        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"SP-TEST-VAR-001\",\n  \"sku\": \"SKU-VAR-001\",\n  \"stock_status_id\": 7,\n  \"shipping\": 1,\n  \"is_add_cart\": 1,\n  \"is_custom\": 0,\n  \"is_review\": 1,\n  \"weight\": 0.5,\n  \"weight_class_id\": 2,\n  \"length_class_id\": 1,\n  \"tax_class_id\": 0,\n  \"sort_order\": 0,\n  \"product_descriptions\": [\n    {\n      \"language_code\": \"vi\",\n      \"name\": \"Sản phẩm test có biến thể\",\n      \"description\": \"\",\n      \"content\": \"\",\n      \"tag\": \"\",\n      \"meta_title\": \"\",\n      \"meta_description\": \"\",\n      \"meta_keyword\": \"\"\n    }\n  ],\n  \"product_categories\": [],\n  \"product_filters\": [],\n  \"product_related\": [],\n  \"product_ingredients\": [],\n  \"product_attributes\": [],\n  \"product_images\": [],\n  \"product_discounts\": [],\n  \"product_rewards\": [],\n  \"product_options\": [\n    {\n      \"option_id\": 1,\n      \"role\": 1,\n      \"required\": 0,\n      \"value\": \"\",\n      \"option_value_ids\": [\n        11,\n        12\n      ]\n    }\n  ],\n  \"product_variants\": [\n    {\n      \"id\": 0,\n      \"price\": 150000,\n      \"regular_price\": 200000,\n      \"sku\": \"VAR-S\",\n      \"minimum\": 1,\n      \"on_hand\": 50,\n      \"inventory_policy\": 0,\n      \"sort_order\": 0,\n      \"is_default\": 1,\n      \"special_price\": \"\",\n      \"special_date_start\": \"\",\n      \"special_date_end\": \"\",\n      \"option_value_ids\": [\n        11\n      ]\n    },\n    {\n      \"id\": 0,\n      \"price\": 160000,\n      \"regular_price\": 210000,\n      \"sku\": \"VAR-M\",\n      \"minimum\": 2,\n      \"on_hand\": 30,\n      \"inventory_policy\": 1,\n      \"sort_order\": 1,\n      \"is_default\": 0,\n      \"special_price\": 139000,\n      \"special_date_start\": \"2026-07-19\",\n      \"special_date_end\": \"2026-08-19\",\n      \"option_value_ids\": [\n        12\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
