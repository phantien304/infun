            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/product",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "product"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"SP-TEST-001\",\n  \"sku\": \"SKU-TEST-001\",\n  \"stock_status_id\": 7,\n  \"shipping\": 1,\n  \"is_add_cart\": 1,\n  \"is_custom\": 0,\n  \"is_review\": 1,\n  \"weight\": 0.5,\n  \"weight_class_id\": 2,\n  \"length_class_id\": 1,\n  \"tax_class_id\": 0,\n  \"sort_order\": 0,\n  \"badge\": \"sale\",\n  \"date_available\": \"2026-07-19\",\n  \"link_sale\": \"\",\n  \"link_sale_custom\": [],\n  \"product_descriptions\": [\n    {\n      \"language_code\": \"vi\",\n      \"name\": \"Sản phẩm test đơn giản\",\n      \"description\": \"Mô tả ngắn\",\n      \"content\": \"<p>Nội dung</p>\",\n      \"tag\": \"\",\n      \"meta_title\": \"\",\n      \"meta_description\": \"\",\n      \"meta_keyword\": \"\"\n    }\n  ],\n  \"product_categories\": [],\n  \"product_filters\": [],\n  \"product_related\": [],\n  \"product_ingredients\": [],\n  \"product_attributes\": [],\n  \"product_images\": [],\n  \"product_discounts\": [],\n  \"product_rewards\": [],\n  \"product_options\": [],\n  \"product_variants\": [\n    {\n      \"id\": 0,\n      \"price\": 150000,\n      \"regular_price\": 200000,\n      \"sku\": \"SKU-TEST-001\",\n      \"minimum\": 1,\n      \"on_hand\": 100,\n      \"inventory_policy\": 0,\n      \"sort_order\": 0,\n      \"is_default\": 1,\n      \"special_price\": 129000,\n      \"special_date_start\": \"2026-07-19\",\n      \"special_date_end\": \"2026-08-19\",\n      \"option_value_ids\": []\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Sản phẩm đơn giản: product_options rỗng + đúng 1 product_variants[is_default=1]. Backend ghi price/regular_price/minimum vào product_variant, on_hand/inventory_policy vào product_stock, special_* vào product_variant_special. Trả 201 { data }."
      }
    },
    {
      "name": "Product - Create (With Variants)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
