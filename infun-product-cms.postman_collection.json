{
  "info": {
    "name": "INFUN — Product CMS (rcms)",
    "_postman_id": "00000000-0000-4000-8000-000000000001",
    "description": "CMS Product API (prefix /rcms, Sanctum Bearer). Chạy \"Auth - Login\" trước để tự lưu {{token}}. Sửa {{base_url}} theo môi trường (vd http://localhost:8000/rcms khi `php artisan serve`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/rcms"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@infun.vn\",\n  \"password\": \"password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Trả { data: { token, account, permissions } }. Test script tự lưu token vào {{token}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j && j.data && j.data.token) {",
              "  pm.collectionVariables.set('token', j.data.token);",
              "  console.log('Saved token');",
              "} else {",
              "  console.log('No token in response');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Resource - dropdown (list_for_product)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/resource?list_for_product=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "resource"
          ],
          "query": [
            {
              "key": "list_for_product",
              "value": "true"
            }
          ]
        },
        "description": "Nguồn dropdown cho form: resource.option[] (kèm option_values), tax_class, stock_status, length_class, weight_class, user_group... Lấy option_id + option_value_id ở đây để tạo product có biến thể."
      }
    },
    {
      "name": "Product - List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/product?per_page=20&keyword=&sort=id&order=desc&deleted_at=-1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "product"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "20"
            },
            {
              "key": "keyword",
              "value": ""
            },
            {
              "key": "sort",
              "value": "id"
            },
            {
              "key": "order",
              "value": "desc"
            },
            {
              "key": "deleted_at",
              "value": "-1"
            }
          ]
        },
        "description": "deleted_at: -1 = tất cả, 0 = chỉ đã xoá, 1 = chưa xoá. sort: id|model|badge|quantity|name."
      }
    },
    {
      "name": "Product - Create (Simple)",
