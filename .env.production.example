# ═══════════════════════════════════════════════════════════════════════════
# MẪU .env cho PRODUCTION (AWS EC2). Copy file này thành `.env` NGAY TRONG
# THƯ MỤC repo trên EC2 (vd /srv/infun/.env) rồi điền giá trị thật.
# KHÔNG commit file .env thật — nó chứa secret. File .example này thì an toàn.
#
# docker compose -f docker-compose.production.yml tự đọc .env cùng thư mục để
# thay ${...}.
# ═══════════════════════════════════════════════════════════════════════════

# App — tạo key mới: echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:CHANGE_ME
# Host thật user truy cập (public IP / domain / sau này là ALB). Vd:
APP_URL=http://<EC2_PUBLIC_IP_OR_DOMAIN>

# RDS MySQL (Phase 3) — endpoint, user, password, tên DB
DB_HOST=infun-prod-db.xxxxxx.ap-southeast-1.rds.amazonaws.com
DB_DATABASE=infun
DB_USERNAME=admin
DB_PASSWORD=CHANGE_ME
# SSL tới RDS (tùy chọn). Bỏ trống = không SSL (đủ an toàn trong VPC riêng).
MYSQL_ATTR_SSL_CA=

# ElastiCache Valkey (Phase 4) — primary endpoint (bỏ :6379)
REDIS_HOST=infun-prod-redis.xxxxxx.ng.0001.apse1.cache.amazonaws.com
REDIS_PASSWORD=

# Meilisearch master key — tạo: openssl rand -hex 16
MEILISEARCH_KEY=CHANGE_ME

# Lưu ảnh: Cloudflare R2 + CDN — COPY y nguyên từ .env DEV của bạn
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=auto
AWS_BUCKET=infun-media
AWS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
AWS_URL=https://cdn.lartisan.vn

LIMIT_ACCESS_ENABLED=false
LIMIT_ACCESS_IPS=

# Số PHP replica (t3.small=2). Resize máy lớn hơn thì tăng.
PROD_PHP_REPLICAS=2
# Cổng web publish trên host (ALB/health check dùng). Mặc định 8100.
PROD_WEB_PORT=8100
