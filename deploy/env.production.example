# ─────────────────────────────────────────────────────────────────────────────
# Các key .env KHÁC BIỆT giữa prod và dev — merge vào .env prod rồi:
#   php artisan config:clear && php artisan config:cache && php artisan route:cache
# (Đối chiếu docs/SCALE-30K.md mục B)
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

# ── MySQL read/write split: 1 master + 2 replica (deploy/mysql/*.cnf) ──
DB_CONNECTION=mysql
# PHƯƠNG ÁN A — qua ProxySQL sidecar (khuyến nghị, deploy/proxysql/):
DB_WRITE_HOST=127.0.0.1        # ProxySQL trên chính app server
DB_WRITE_PORT=6033             # → hostgroup writer (master)
DB_READ_HOST1=127.0.0.1
DB_READ_PORT=6034              # → hostgroup reader (ProxySQL cân giữa các replica)
# PHƯƠNG ÁN B — nối thẳng DB (không ProxySQL): bỏ 2 dòng PORT ở trên và dùng:
# DB_WRITE_HOST=10.0.0.10      # SỬA: IP master
# DB_READ_HOST1=10.0.0.11      # SỬA: IP replica 1
# DB_READ_HOST2=10.0.0.12      # SỬA: IP replica 2
DB_DATABASE=infun
DB_USERNAME=infun_app          # user thường, KHÔNG SUPER (để read_only chặn được)
DB_PASSWORD=CHANGE_ME          # khớp mysql_users trong proxysql.cnf nếu dùng phương án A

# ── Redis tách instance (deploy/redis/*.conf) ──
REDIS_CLIENT=phpredis          # pecl install redis — nhanh hơn hẳn predis
REDIS_HOST=10.0.0.20           # SỬA: instance session+queue (noeviction, :6379)
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_CACHE_HOST=10.0.0.20     # SỬA: instance cache (allkeys-lru, :6380)
REDIS_CACHE_PORT=6380

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CACHE_CONNECTION=cache

# ── Search / media ──
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://10.0.0.30:7700   # SỬA: instance Meilisearch riêng
MEILISEARCH_KEY=CHANGE_ME                # prod BẮT BUỘC master key

# ── Throttle endpoint nóng (config/throttle.php — request/phút/khách) ──
# Mặc định 30/10 là mức prod; chỉ set khi cần khác đi (staging k6 thì nới to).
# THROTTLE_ADD_TO_CART=30
# THROTTLE_SAVE_ORDER=10

# R2 + CDN giữ như hiện tại (đã cấu hình giai đoạn tối ưu)
